# ---------------------------------------------------------------------------
# GOWA OTP-only deployment configuration
#
# Copy this file to .env, replace every CHANGE_ME placeholder, then either
# push to main (GitHub Actions) or run: bash vps-scripts/deploy.sh
#
# Never commit .env. The deployment strips all VPS_* keys before uploading.
# ---------------------------------------------------------------------------

# --- Public entry point -----------------------------------------------------
# Drives this app's Caddy site fragment, automatic HTTPS, and deploy health
# checks. The Caddy base /etc/caddy/Caddyfile is shared with other apps.
PUBLIC_BASE_URL=https://api.whatsapp.ktorganicshop.com

# --- HTTP server ------------------------------------------------------------
# Caddy is the only public listener. GOWA binds loopback only. On a shared VPS
# every app needs its own loopback port (PayConnect uses 8080).
APP_HOST=127.0.0.1
APP_PORT=8081
APP_DEBUG=false
APP_OS=KtOrganic-OTP
# HTTP Basic Auth for every API call. Use a long random password.
APP_BASIC_AUTH=otp:CHANGE_ME_STRONG_PASSWORD
APP_ALLOW_UNAUTHENTICATED=false
APP_TRUSTED_ORIGINS=https://api.whatsapp.ktorganicshop.com
APP_BASE_PATH=
# Caddy connects from loopback; trust its forwarded headers.
APP_TRUSTED_PROXIES=127.0.0.1/32
APP_CORS_ALLOWED_ORIGINS=

# --- API-only surface -------------------------------------------------------
# No dashboard and no MCP endpoint: this deployment only sends OTP messages.
APP_UI_ENABLED=false
APP_UI_AUTO_UPDATE=false
MCP_ENABLED=false

# --- Database ---------------------------------------------------------------
# WhatsApp sessions and encryption keys. MUST be PostgreSQL for this deployment;
# the deployment refuses to start with a local SQLite file.
#
# Local PostgreSQL on the same VPS (recommended for a small deployment):
#   DB_URI=postgres://gowa:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/gowa?sslmode=disable
#
# Managed PostgreSQL: use the DIRECT hostname, never a transaction pooler
# (`-pooler`, PgBouncer transaction mode, etc.). GOWA uses lib/pq prepared
# statements and session state; poolers cause errors such as
# "unnamed prepared statement does not exist" and "bind message supplies ...".
DB_URI=postgres://gowa:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/gowa?sslmode=disable
# Leave blank so session keys stay in DB_URI (survives restarts).
DB_KEYS_URI=
# Chat/message history is intentionally in-memory: nothing is written to disk
# and history is discarded when the service restarts. SQLite is the only
# supported engine for this store.
CHAT_STORAGE_URI=file::memory:?cache=shared
# Required for a shared in-memory database.
CHAT_STORAGE_MAX_OPEN_CONNS=1

# --- WhatsApp behaviour (OTP sender) ---------------------------------------
WHATSAPP_AUTO_REPLY=
WHATSAPP_AUTO_MARK_READ=false
WHATSAPP_AUTO_DOWNLOAD_MEDIA=false
WHATSAPP_IGNORE_STATUS_MEDIA=true
WHATSAPP_AUTO_REJECT_CALL=true
WHATSAPP_ACCOUNT_VALIDATION=true
WHATSAPP_PRESENCE_ON_CONNECT=unavailable
WHATSAPP_PRESENCE_PULSE_ENABLED=false
WHATSAPP_PROXY=

# --- Webhooks (optional) ----------------------------------------------------
# Use webhooks only if your OTP service needs delivery/read receipts.
# Events are signed with X-Hub-Signature-256 when a secret is set.
WHATSAPP_WEBHOOK=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_INSECURE_SKIP_VERIFY=false
WHATSAPP_WEBHOOK_EVENTS=message.ack
WHATSAPP_WEBHOOK_IGNORE_JIDS=

# --- Shared Caddy routing (one VPS can host many apps) ----------------------
# The site id names /etc/caddy/sites-enabled/<id>.caddy; the deploy only ever
# writes that one file. APP_PORT above must stay unique too.
GOWA_CADDY_SITE_ID=gowa-otp
# Optional: reverse_proxy target when it differs from 127.0.0.1:<APP_PORT>,
# for example a Docker container on a shared network.
# GOWA_CADDY_UPSTREAM=127.0.0.1:8081
# Optional: extra hostnames served by the same app (comma-separated).
# GOWA_CADDY_EXTRA_HOSTS=www.whatsapp.ktorganicshop.com

# --- Chatwoot (disabled) ----------------------------------------------------
CHATWOOT_ENABLED=false

# ---------------------------------------------------------------------------
# VPS deployment only. These keys are removed from the bundle before upload.
# ---------------------------------------------------------------------------

# Public IP or hostname used for SSH. The deploy never probes the bare IP for
# health: Caddy is shared, so the IP may route to another app.
VPS_HOST=203.0.113.10
VPS_SSH_PORT=22
VPS_SSH_USER=root
# Use VPS_SSH_KEY_PATH for a local key file, or VPS_SSH_KEY for key content.
VPS_SSH_KEY_PATH=~/.ssh/gowa_vps
VPS_SSH_KEY=
# amd64 or arm64.
VPS_GOARCH=amd64
# Optional Let's Encrypt account email.
VPS_ACME_EMAIL=ops@ktorganicshop.com
